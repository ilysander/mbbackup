def jscrambler(platform, name)
  temp_dir = File.expand_path("../.jscrambler/", __dir__)
  {
        :DIST => nexus(platform, "#{name}_dist", zip_file(File.expand_path("dist", temp_dir))),
        :SRC => nexus(platform, "#{name}_src", zip_file(File.expand_path("src", temp_dir))),
        :SourceMaps => nexus(platform, "#{name}_sourcemap", zip_file(jscrambler_sourcemap)),
  }
end

def jscrambler_sourcemap
  jscrambler = File.expand_path("../node_modules/.bin/jscrambler", __dir__)
  jscrambler_temp_dir = File.expand_path("../.jscrambler", __dir__)
  config_source = File.expand_path("../.jscramblerrc", __dir__)
  config = File.expand_path("config.json", jscrambler_temp_dir)
  copy(config_source, config)
  protection_id = File.expand_path("protectionId", jscrambler_temp_dir)
  output_dir = File.expand_path("sourcemap", jscrambler_temp_dir)
  FileUtils.mkdir_p(output_dir)
  copy(protection_id, File.expand_path("protectionId", output_dir))

  sh(jscrambler, "--config", config, "--output-dir", output_dir, "--source-maps", File.read(protection_id))
  File.delete(config)
  output_dir
end

def yarn
  sh("yarn", "install", "--pure-lockfile")
end

def zip_file(path)
  output_path = "#{path}.zip"
  zip(path: path, output_path: output_path)
  output_path
end

def gradle_properties
  gradle_properties_file = File.expand_path("../android/gradle.properties", __dir__)
  copy("#{gradle_properties_file}-dist", gradle_properties_file)

  sed("ENV_RELEASE_STORE_FILE", ENV["RELEASE_STORE_FILE"], gradle_properties_file)
  sed("ENV_RELEASE_KEY_ALIAS", ENV["RELEASE_KEY_ALIAS"], gradle_properties_file)
  sed("ENV_RELEASE_STORE_PASSWORD", ENV["RELEASE_STORE_PASSWORD"], gradle_properties_file)
  sed("ENV_RELEASE_KEY_PASSWORD", ENV["RELEASE_KEY_PASSWORD"], gradle_properties_file)

  sed("ENV_MAVEN_REPO_URL", ENV["MAVEN_REPO_URL"], gradle_properties_file)
  sed("ENV_MAVEN_REPO_USERNAME", ENV["MAVEN_REPO_USERNAME"], gradle_properties_file)
  sed("ENV_MAVEN_REPO_PASSWORD", ENV["MAVEN_REPO_PASSWORD"], gradle_properties_file)

  sed("ENV_DEXGUARD_ENABLE", ENV["DEXGUARD_ENABLE"], gradle_properties_file)
  sed("ENV_DEXGUARD_LIBS", ENV["DEXGUARD_LIBS"], gradle_properties_file)
  sed("ENV_DEXGUARD_LICENSE", ENV["DEXGUARD_LICENSE"], gradle_properties_file)
  sed("ENV_DEXGUARD_DIR", ENV["DEXGUARD_DIR"], gradle_properties_file)

  sed("ENV_GUARDSQUARE_KEY", ENV["GUARDSQUARE_KEY"], gradle_properties_file)

  sed("ENV_VERSION_CODE", ENV["BUILD_ID"], gradle_properties_file)

end

def config(env)
  config_file = File.expand_path("../src/Config.tsx", __dir__)
