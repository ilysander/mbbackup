def on_error(platform, name, exception)
  message = "ERROR: #{platform} #{name} - Build: #{ENV["BUILD_ID"]}"

  if FastlaneCore::Helper.mac?
    notification(subtitle: "Error Build", message: message)
  end

  if ENV["SLACK_URL"].to_s == ""
    UI.header "SLACK FALLBACK: #{message}"
  else
    slack(
        message: message,
        success: false,
        payload: {
            :DexGuard => ENV["DEXGUARD_ENABLE"],
            :iXGuard => ENV["IXGUARD_ENABLE"],
            :JSCrambler => ENV["JSCRAMBLER_ENABLE"]
        },
        attachment_properties: {
            fields: [
                {
                    title: "Error message",
                    value: exception.to_s,
                    short: false
                }
            ]
        }
    )
  end
  UI.user_error!(exception.to_s)
end

def on_success(platform, name, urls)
  message = "SUCCESSFUL: #{platform} #{name} - Build: #{ENV["BUILD_ID"]}"

  fields = urls.collect { |idx, url| {
      title: "URL #{idx}",
      value: url,
      short: false
  } }
  actions = urls.collect { |idx, url| {
      type: "button",
      text: "Download #{idx}",
      url: url,
      style: "primary"
  } }

  if FastlaneCore::Helper.mac?
    notification(subtitle: "Success Build", message: message)
  end

  if ENV["SLACK_URL"].to_s == ""
    UI.header "SLACK FALLBACK: #{message}"
  else
    slack(
        message: message,
        success: true,
        payload: {
            :DexGuard => ENV["DEXGUARD_ENABLE"],
            :iXGuard => ENV["IXGUARD_ENABLE"],
            :JSCrambler => ENV["JSCRAMBLER_ENABLE"]
        },
        attachment_properties: {
            fields: fields,
            actions: actions
        }
    )
  end

  urls.collect { |idx, url|
    UI.header "URL #{idx}: #{url}"
  }

end

def on_start(platform, name)
  message = "STARTED: #{platform} #{name} - Build: #{ENV["BUILD_ID"]}"
  if FastlaneCore::Helper.mac?
    notification(subtitle: "Start Build", message: message)
