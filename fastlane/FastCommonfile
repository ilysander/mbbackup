def prepare_android_release(name, task, project_dir)
  prepare_android(name, task, project_dir)
  gradle_tasks(task, project_dir)
end

def prepare_android_bundle(name, task, project_dir)
  prepare_android(name, task, project_dir)
  gradle_properties
  sh("./android-bundle.sh")
  #sh("cd #{project_dir} && ./gradlew #{task} || echo true")
  gradle_tasks(task, project_dir)
end

def prepare_android(name, task, project_dir)
  config(name)
  yarn
  instabug_dir = File.expand_path("../node_modules/instabug-reactnative", __dir__)
  sed("export NODE_BINARY=node", "exit 0", File.expand_path("android/upload_sourcemap.sh", instabug_dir))
  # sh("yarn", "jetify")
end

def gradle_tasks(task, project_dir)
  gradle_properties
  gradle(task: task, project_dir: project_dir)
end

def move_sourcemap(sourcemap_file,sourcemap_dir)
  sh("mv",sourcemap_file,sourcemap_dir)
end

def remove_sourcemap(sourcemap_file)
  sh("rm",sourcemap_file)
end

def prepare_ios(name, output, podfile, xcodeproj)
  config(name)
  yarn
  instabug_dir = File.expand_path("../node_modules/instabug-reactnative", __dir__)
  sed("export NODE_BINARY=node", "exit 0", File.expand_path("ios/upload_sourcemap.sh", instabug_dir))
  cocoapods(repo_update: true, podfile: podfile)
  increment_build_number(build_number: ENV["BUILD_ID"], xcodeproj: xcodeproj)
  FileUtils.remove_dir(output, true)

  pbxproj = File.expand_path("project.pbxproj", xcodeproj)
  if ENV["JSCRAMBLER_ENABLE"] == "true"
    sed("JSCRAMBLER_ENABLE=false", "JSCRAMBLER_ENABLE=true", pbxproj)
  else
    sed("JSCRAMBLER_ENABLE=true", "JSCRAMBLER_ENABLE=false", pbxproj)
  end

end

def restore_ios(xcodeproj)
  pbxproj = File.expand_path("project.pbxproj", xcodeproj)
  if ENV["JSCRAMBLER_ENABLE"] == "true"
    sed("JSCRAMBLER_ENABLE=true", "JSCRAMBLER_ENABLE=false", pbxproj)
  end
end

