end

def ixguard(config, input, output, output_dir)
  sh("ixguard", "-force", "-local", "-debug-data", output_dir, "-config", config, "-o", output, input)
end

def ofuscate(ipa, output, template, yml_archive)
  UI.header "iXGuard"
  ixguard_config = File.expand_path(yml_archive, output)
  copy(template, ixguard_config)
  sed("ENV_IXGUARD_LICENSE", ENV["IXGUARD_LICENSE"], ixguard_config)
  if yml_archive == "ixguard_adhoc.yml"
    sed("ENV_IXGUARD_EXPORT_PROVISIONING_FILE", ENV["IXGUARD_EXPORT_PROVISIONING_FILE"], ixguard_config)
  end
  ofuscated = File.expand_path("Ofuscated.ipa", output)
  ixguard(ixguard_config, ipa, ofuscated, output)
  ofuscated
end

