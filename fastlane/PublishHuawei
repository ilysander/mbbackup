lane :publish_draft_appgallery do    

	huawei_appgallery_connect(
		client_id: ENV["CLIENT_ID"],
		client_secret: ENV["SECRET_KEY"],
		app_id: ENV["APP_ID"],
		apk_path: ENV["APK_PATH"],
		is_aab: ENV["IS_AAB"],
		changelog_path: ENV["PATH_TO_CHANGELOG_FILE"],
		submit_for_review: ENV["SUBMIT_FOR_REVIEW"],
	)
end

lane :publish_appgallery do    

	huawei_appgallery_connect_submit_for_review(
		client_id: ENV["CLIENT_ID"],
		client_secret: ENV["SECRET_KEY"],
		app_id: ENV["APP_ID"]
	)
end