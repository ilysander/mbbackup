{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "types": ["react-native", "jest"],
    "lib": [
      "es2019",
      "dom"
    ],
    "allowJs": true,
    "jsx": "react-native",
    "sourceMap": true,
    "removeComments": true,
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,        
    "emitDecoratorMetadata": true,
    "rootDirs": [
      "src"
    ],  
    "typeRoots": [                         
      "@types",
      "node_modules/@types",
      "src/@types"
    ],
  },
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "libraries",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}