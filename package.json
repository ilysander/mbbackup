    "@react-native-agconnect/remoteconfig": "file:./libraries/@react-native-agconnect/remoteconfig",
    "@react-native-community/async-storage": "^1.12.1",
    "@react-native-community/cli": "^11.2.1",
    "@react-native-community/netinfo": "^9.3.7",
