    "@react-native-firebase/crashlytics": "14.11.1",
    "@react-native-firebase/functions": "14.11.1",
    "@react-native-firebase/messaging": "14.11.1",
    "@react-native-firebase/perf": "14.11.1",
    "@react-native-firebase/remote-config": "14.11.1",
    "@react-navigation/bottom-tabs": "^6.5.7",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/native-stack": "^6.9.12",
    "RN-custom-keyboard": "file:./libraries/RN-custom-keyboard",
    "accounting": "^0.4.1",
    "base-64": "^1.0.0",
    "compare-versions": "5.0.3",
    "crypto-js": "3.1.9-1",
    "husky": "4.2.5",
