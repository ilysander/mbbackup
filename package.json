    "jail-monkey": "file:./libraries/jail-monkey",
    "lottie-react-native": "^6.0.0-rc.3",
    "mitt": "^3.0.0",
    "moment": "^2.29.4",
    "react": "18.1.0",
    "react-native": "0.70.8",
    "react-native-custom-tabs": "https://github.com/greg7gkb/react-native-custom-tabs#2e049aaf71ac13f44288255fe04fd1643af30dd7",
    "react-native-device-info": "^10.4.0",
    "react-native-fast-rsa": "https://github.com/ilysander/react-native-fast-rsa#10b312346994f324b6313cf5d3e93be1ef43589c",
