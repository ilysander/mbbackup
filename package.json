{
  "name": "mibancomovil",
  "version": "3.14.0",
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/runtime": "^7.12.5",
    "@react-native-community/eslint-config": "^2.0.0",
    "@tsconfig/react-native": "^2.0.2",
    "@types/crypto-js": "3.1.47",
    "@types/jest": "^26.0.23",
    "@types/react": "^18.0.21",
    "@types/react-native": "^0.70.6",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.37.0",
    "@typescript-eslint/parser": "^5.37.0",
    "babel-jest": "^26.6.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^7.32.0",
    "jest": "^26.6.3",
    "lint-staged": "^13.2.1",
    "metro-react-native-babel-preset": "0.72.3",
    "onchange": "^7.1.0",
    "prettier": "^2.8.7",
    "react-test-renderer": "18.1.0",
    "sonarlint": "^1.1.0",
    "typescript": "^4.8.3"
  },
  "scripts": {
    "start": "react-native start",
    "prettier": "prettier --write --single-quote 'src/**/*.tsx'",
    "android": "react-native run-android --appIdSuffix dev",
    "ios": "react-native run-ios",
    "ios:bundle:dev": "react-native bundle --entry-file='index.js' --bundle-output='./ios/main.jsbundle' --dev=true --platform='ios' --assets-dest='./ios'",
    "ios:bundle:release": "react-native bundle --entry-file='index.js' --bundle-output='./ios/main.jsbundle' --dev=false --platform='ios' --assets-dest='./ios'",
    "test": "jest",
    "test:u": "jest --updateSnapshot",
    "test:watch": "onchange 'src/**/*.tsx' -- jest {{changed}}",
    "lint": "tsc && sonarlint --src 'src/**/*.tsx' && eslint --ext tsconfig.json",
    "docs": "echo 1"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write --single-quote",
      "git add"
    ],
    "*.tsx": [
      "prettier --write --single-quote",
      "git add"
    ]
  },
  "dependencies": {
    "@hmscore/react-native-hms-analytics": "file:./libraries/@hmscore/react-native-hms-analytics",
    "@notifee/react-native": "5.7.0",
